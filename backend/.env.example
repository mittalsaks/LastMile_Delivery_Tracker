# --- Server ---
PORT=5000

# --- Database ---
# Get this from MongoDB Atlas -> Connect -> Drivers. NEVER commit a real
# connection string here -- this file ships in git.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lastmile?retryWrites=true&w=majority

# --- Auth ---
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<replace-with-a-long-random-string>
JWT_EXPIRE=7d

# --- Email (Gmail API via OAuth2) — Part 7 ---
GMAIL_API_CLIENT_ID=<your-gmail-oauth-client-id>
GMAIL_API_CLIENT_SECRET=<your-gmail-oauth-client-secret>
GMAIL_API_REFRESH_TOKEN=<your-gmail-oauth-refresh-token>
GMAIL_API_SENDER_EMAIL=<your-sender-gmail-address>

# --- Google Sign-In (Part 10) ---
# Create an OAuth 2.0 "Web application" Client ID at
# https://console.cloud.google.com/apis/credentials — add
# http://localhost:5173 (and your deployed frontend URL) under
# "Authorized JavaScript origins". Only the Client ID is needed here
# (no client secret) since the backend only verifies the ID token.
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# --- SMS (optional, currently a stub — Part 7) ---
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- CORS (Part 9 / deployment) ---
CLIENT_ORIGIN=
