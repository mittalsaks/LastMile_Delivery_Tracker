# Base URL the frontend calls for API requests.
# Local dev: "/api" (Vite proxies this to the backend — see vite.config.js)
# Production: full deployed backend URL + /api, e.g.
#   https://lastmile-backend.onrender.com/api
VITE_API_BASE_URL=/api

# --- Google Sign-In (Part 10) ---
# Same Client ID you created in Google Cloud Console for the backend's
# GOOGLE_CLIENT_ID (backend/.env) — this one is safe to expose publicly,
# it's the same value used by every "Sign in with Google" button on the web.
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
